#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 3

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    behaviors {
        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W      &kp E         &kp R          &kp T                                                      &kp Y      &kp U      &kp I      &kp O      &kp P
&kp A           &kp S      &kp D         &kp F          &kp G                              &mo 1                  &kp H      &kp J      &kp K      &kp L      &kp SEMICOLON
&kp Z           &kp X      &kp C         &kp V          &kp B        &mo 3                 &mo 2                  &kp N      &kp M      &kp COMMA  &kp DOT    &kp SLASH
&kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_WIN  &kp BACKSPACE  &kp ENTER    &kp LANG2             &kp LANG1             &kp SPACE                          &kp LEFT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4       &kp NUMBER_5                          &kp NUMBER_6       &kp NUMBER_7      &kp NUMBER_8      &kp NUMBER_9  &kp NUMBER_0
&kp EXCLAMATION  &kp AT_SIGN  &kp POUND  &kp DOLLAR         &kp PERCENT                 &trans  &kp CARET          &kp AMPERSAND     &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp GRAVE     &kp TILDE     &kp SQT       &kp DOUBLE_QUOTES  &kp BACKSLASH    &trans    &trans  &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp MINUS       &kp EQUAL     &kp PLUS
&trans        &trans        &trans        &trans             &trans           &trans    &trans  &trans                                                        &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&kp ESC             &kp TAB              &kp LG(LS(NUMBER_4))  &kp LC(UP_ARROW)     &kp LC(DOWN_ARROW)                          &kp HOME  &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp END
&kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)  &kp LA(LEFT_ARROW)    &kp LA(RIGHT_ARROW)  &kp DELETE                     &trans    &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&kp F1              &kp F2               &kp F3                 &kp F4               &kp F5       &kp F11    &trans    &kp F6    &kp F7          &kp F8          &kp F9          &kp F10
&trans              &trans               &trans                 &trans               &trans       &trans     &trans    &trans                                                    &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

    };
};
